{
  "name": "OHC Prism Segments",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "cpu-load",
      "type": "metric",
      "x": 760,
      "y": 305,
      "metric": "cpu:usage",
      "format": "{value:.0f}%",
      "color": "#ffffff",
      "size": 92,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "cpu-temp",
      "type": "metric",
      "x": 760,
      "y": 405,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#79efff",
      "size": 30,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu-temp",
      "type": "metric",
      "x": 260,
      "y": 235,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#ff78d5",
      "size": 36,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu-power",
      "type": "metric",
      "x": 260,
      "y": 470,
      "metric": "gpu:primary:power",
      "format": "GPU  {value:.0f} W",
      "color": "#ffba62",
      "size": 30,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "cpu-power",
      "type": "metric",
      "x": 1260,
      "y": 235,
      "metric": "cpu:power",
      "format": "CPU  {value:.0f} W",
      "color": "#72eaff",
      "size": 30,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 1260,
      "y": 470,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#8dff73",
      "size": 36,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "clock",
      "type": "clock",
      "x": 760,
      "y": 620,
