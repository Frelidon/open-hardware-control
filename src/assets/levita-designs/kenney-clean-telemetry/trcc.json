{
  "name": "Clean Telemetry",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "clock",
      "type": "clock",
      "x": 760,
      "y": 92,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 50,
      "bold": true
    },
    {
      "id": "cpu-temp",
      "type": "metric",
      "x": 260,
      "y": 255,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#60dcff",
      "size": 34,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "cpu-load",
      "type": "metric",
      "x": 260,
      "y": 390,
      "metric": "cpu:usage",
      "format": "LOAD  {value:.0f}%",
      "color": "#ffffff",
      "size": 30,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "gpu-temp",
      "type": "metric",
      "x": 760,
      "y": 255,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#9aaaff",
      "size": 34,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "gpu-load",
      "type": "metric",
      "x": 760,
      "y": 390,
      "metric": "gpu:primary:usage",
      "format": "LOAD  {value:.0f}%",
      "color": "#ffffff",
      "size": 30,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 1260,
      "y": 255,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#72f4cf",
      "size": 34,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "disk",
      "type": "metric",
      "x": 1260,
      "y": 390,
      "metric": "disk:activity",
      "format": "DISK  {value:.0f}%",
      "color": "#ffffff",
      "size": 30,
      "bold": true,
      "show_unit": true
    }
  ]
}
