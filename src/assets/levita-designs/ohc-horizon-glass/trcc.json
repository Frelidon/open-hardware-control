{
  "name": "OHC Horizon Glass",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "clock",
      "type": "clock",
      "x": 760,
      "y": 150,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 78,
      "bold": true,
      "name": "DejaVu Sans"
    },
    {
      "id": "cpu",
      "type": "metric",
      "x": 300,
      "y": 510,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#8ee8ff",
      "size": 36,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu",
      "type": "metric",
      "x": 700,
      "y": 510,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#b4a7ff",
      "size": 36,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 1100,
      "y": 510,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#ffbf7d",
      "size": 36,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "disk",
      "type": "metric",
      "x": 1400,
      "y": 610,
      "metric": "disk:activity",
      "format": "SSD  {value:.0f}%",
      "color": "#ffffff",
      "size": 25,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    }
  ]
}
