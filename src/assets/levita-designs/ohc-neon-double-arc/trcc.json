{
  "name": "OHC Neon Double Arc",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "cpu-temp",
      "type": "metric",
      "x": 400,
      "y": 310,
      "metric": "cpu:temp",
      "format": "{value:.0f}°C",
      "color": "#ffffff",
      "size": 78,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "cpu-load",
      "type": "metric",
      "x": 400,
      "y": 405,
      "metric": "cpu:usage",
      "format": "CPU  {value:.0f}%",
      "color": "#72efff",
      "size": 30,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu-temp",
      "type": "metric",
      "x": 1110,
      "y": 310,
      "metric": "gpu:primary:temp",
      "format": "{value:.0f}°C",
      "color": "#ffffff",
      "size": 78,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu-load",
      "type": "metric",
      "x": 1110,
      "y": 405,
      "metric": "gpu:primary:usage",
      "format": "GPU  {value:.0f}%",
      "color": "#ff82d1",
      "size": 30,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 755,
      "y": 585,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#91ff78",
      "size": 34,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "clock",
      "type": "clock",
      "x": 755,
      "y": 100,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 42,
      "bold": true,
      "name": "DejaVu Sans"
    }
  ]
}
