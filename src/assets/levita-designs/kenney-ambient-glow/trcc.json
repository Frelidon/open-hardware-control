{
  "name": "Ambient Glow",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "clock",
      "type": "clock",
      "x": 760,
      "y": 250,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 92,
      "bold": true
    },
    {
      "id": "cpu",
      "type": "metric",
      "x": 330,
      "y": 565,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#5ce7ff",
      "size": 38,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "gpu",
      "type": "metric",
      "x": 760,
      "y": 565,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#9c7cff",
      "size": 38,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 1190,
      "y": 565,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#70ffd1",
      "size": 38,
      "bold": true,
      "show_unit": true
    }
  ]
}
