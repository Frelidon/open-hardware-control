{
  "name": "OHC Aurora Radar",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "clock",
      "type": "clock",
      "x": 760,
      "y": 92,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 44,
      "bold": true,
      "name": "DejaVu Sans"
    },
    {
      "id": "cpu-temp",
      "type": "metric",
      "x": 420,
      "y": 300,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#63f5e3",
      "size": 42,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "cpu-load",
      "type": "metric",
      "x": 420,
      "y": 390,
      "metric": "cpu:usage",
      "format": "LOAD  {value:.0f}%",
      "color": "#ffffff",
      "size": 29,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu-temp",
      "type": "metric",
      "x": 1090,
      "y": 300,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#c987ff",
      "size": 42,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "gpu-load",
      "type": "metric",
      "x": 1090,
      "y": 390,
      "metric": "gpu:primary:usage",
      "format": "LOAD  {value:.0f}%",
      "color": "#ffffff",
      "size": 29,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 760,
      "y": 585,
      "metric": "memory:percent",
      "format": "MEMORY  {value:.0f}%",
      "color": "#9dff75",
      "size": 34,
      "bold": true,
      "name": "DejaVu Sans",
      "show_unit": true
    }
  ]
}
