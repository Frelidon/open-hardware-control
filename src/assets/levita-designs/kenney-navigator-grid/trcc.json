{
  "name": "Navigator Grid",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "clock",
      "type": "clock",
      "x": 245,
      "y": 105,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 54,
      "bold": true
    },
    {
      "id": "cpu-temp",
      "type": "metric",
      "x": 250,
      "y": 270,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#74ffc8",
      "size": 38,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "gpu-temp",
      "type": "metric",
      "x": 250,
      "y": 375,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#75b9ff",
      "size": 38,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 250,
      "y": 480,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#ffffff",
      "size": 34,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "net-down",
      "type": "metric",
      "x": 1130,
      "y": 580,
      "metric": "net:down",
      "format": "DOWN  {value:.0f}",
      "color": "#74ffc8",
      "size": 27,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "net-up",
      "type": "metric",
      "x": 1360,
      "y": 580,
      "metric": "net:up",
      "format": "UP  {value:.0f}",
      "color": "#75b9ff",
      "size": 27,
      "bold": true,
      "show_unit": true
    }
  ]
}
