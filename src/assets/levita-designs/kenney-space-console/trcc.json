{
  "name": "Space Console",
  "width": 1600,
  "height": 720,
  "overlay_enabled": true,
  "elements": [
    {
      "id": "clock",
      "type": "clock",
      "x": 760,
      "y": 118,
      "source": "time",
      "format": "{value}",
      "color": "#ffffff",
      "size": 62,
      "bold": true
    },
    {
      "id": "cpu-temp",
      "type": "metric",
      "x": 270,
      "y": 280,
      "metric": "cpu:temp",
      "format": "CPU  {value:.0f}°C",
      "color": "#65e6ff",
      "size": 38,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "cpu-load",
      "type": "metric",
      "x": 270,
      "y": 370,
      "metric": "cpu:usage",
      "format": "LOAD  {value:.0f}%",
      "color": "#ffffff",
      "size": 30,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "gpu-temp",
      "type": "metric",
      "x": 1240,
      "y": 280,
      "metric": "gpu:primary:temp",
      "format": "GPU  {value:.0f}°C",
      "color": "#aa9cff",
      "size": 38,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "gpu-load",
      "type": "metric",
      "x": 1240,
      "y": 370,
      "metric": "gpu:primary:usage",
      "format": "LOAD  {value:.0f}%",
      "color": "#ffffff",
      "size": 30,
      "bold": true,
      "show_unit": true
    },
    {
      "id": "ram",
      "type": "metric",
      "x": 760,
      "y": 600,
      "metric": "memory:percent",
      "format": "RAM  {value:.0f}%",
      "color": "#85f5d5",
      "size": 32,
      "bold": true,
      "show_unit": true
    }
  ]
}
