# Open Hardware Control by Frelidon / NZXT Kraken liquidctl access rules
# Must sort before 73-seat-late.rules so TAG+=uaccess is applied correctly.

# NZXT Kraken 2023 (1e71:300e)
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="300e", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="300e", MODE="0660", TAG+="uaccess"

# NZXT Kraken 2023 Elite (1e71:300c) — detection only in OHC while liquidctl marks this ID broken
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="300c", MODE="0660", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="300c", MODE="0660", TAG+="uaccess"

